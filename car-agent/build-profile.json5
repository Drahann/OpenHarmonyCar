{
  "app": {
    // 签名留空：在 DevEco「File → Project Structure → Signing Configs」勾选 *Automatically generate signature* 自动生成。
    // bundle 必须 = com.example.carapp（与平板 app-harmony 同名）——distributedDataObject 黑板跨设备同步的硬前提。
    // 已有 app-harmony 的 com.example.carapp 调试证书，可复用同一证书；如装机报"设备不在 profile"，让 DevEco 重新自动签名以登记紫派设备。不在仓库提交签名密钥。
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:\\Users\\draha\\.ohos\\config\\default_car-agent_W100yLNFI9Lux3ilt4v8miJb7eO20kFY6rayvMiDVxU=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B205B50DF15F23A43B719090CE5D012BEF7A7D5BC34779C36DD4078A86FE01E2A6E27742559A71C",
          "profile": "C:\\Users\\draha\\.ohos\\config\\default_car-agent_W100yLNFI9Lux3ilt4v8miJb7eO20kFY6rayvMiDVxU=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:\\Users\\draha\\.ohos\\config\\default_car-agent_W100yLNFI9Lux3ilt4v8miJb7eO20kFY6rayvMiDVxU=.p12",
          "storePassword": "0000001B27F7D3121B7C97943C2B26A2699FF329F15BCCEDA9528A515536739B8C58EE87A36EEA260CCB3D"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // 与 app-harmony / 紫派(OH5.0 · API12) 对齐：compatible 与 target 都压到 5.0.0(12)，避免 6.x 目标在 API12 设备上的行为差异。
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
