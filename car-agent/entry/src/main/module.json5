// car-agent 模块清单。运行时入口 = **AgentAbility（UIAbility 外壳）**托管 AgentCore（黑板↔本机 UDP 桥）。
// 为什么不是 headless ServiceExtensionAbility：它是系统 API，第三方公共 SDK 编不过（见 docs/car-agent-plan.md §6.5 /
//   contracts/integration-qa.md Q6.1）。当前 UIAbility 壳=可用公共 SDK 编译/装机/联调的过渡形态；逻辑全在 AgentCore，
//   将来上紫派系统应用时换 ServiceExtension 壳托管同一 core 即可。另含一次性配对 PairingAbility（配网期拉起，处理 PIN）。
// ⚠️ deviceTypes/开机自起仍待紫派系统侧（A）校验。
{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "车载 agent（紫派常驻；当前 UIAbility 外壳过渡形态）",
    "mainElement": "AgentAbility",
    "pages": "$profile:pairing_pages",
    "deviceTypes": [
      "default"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:perm_datasync",
        "usedScene": {
          "abilities": [
            "AgentAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "AgentAbility",
        "srcEntry": "./ets/agentability/AgentAbility.ets",
        "description": "车载 agent 运行时入口（UIAbility 外壳，托管 AgentCore：黑板↔本机 UDP 桥）",
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "PairingAbility",
        "srcEntry": "./ets/pairingability/PairingAbility.ets",
        "description": "一次性设备互信配对界面（仅配网期手动拉起；运行时用 AgentAbility）",
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ]
  }
}
